# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Database
DATABASE_PATH=./data/monitor.db

# GenLayer
GENLAYER_NETWORK=localnet
GENLAYER_RPC_URL=http://localhost:4000/api
GENLAYER_PRIVATE_KEY=
NOMI_SINGULARITY_CONTRACT_ADDRESS=

# Web dashboard
WEB_DASHBOARD_ENABLED=false
# Defaults to PORT on hosted platforms when WEB_PORT is empty.
WEB_PORT=3000
WEB_BIND_HOST=127.0.0.1
WEB_PUBLIC_URL=
WEB_ADMIN_TOKEN=

# Channel IDs (comma-separated for multiple)
ADMIN_ALERT_CHANNEL_ID=
PROJECT_POST_CHANNEL_IDS=
WINNER_ANNOUNCEMENT_CHANNEL_IDS=

# Role IDs (comma-separated for multiple)
OFFICIAL_ANNOUNCER_ROLE_IDS=

# Thresholds
MEANINGFUL_MESSAGE_MIN_LENGTH=30
DAILY_MESSAGE_CAP=50
WEEKLY_POST_CAP=3
SPAM_BURST_WINDOW_SECONDS=10
SPAM_BURST_MAX_MESSAGES=5
